# Google OAuth 2.0 Client ID (lấy từ Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Chuỗi bí mật để ký Session Cookie (đặt chuỗi ngẫu nhiên dài)
SESSION_SECRET=thay-bang-chuoi-bi-mat-ngau-nhien-dai

# ID của Google Sheet trên Google Drive (phần nằm giữa /d/ và /edit trong URL)
# Để trống nếu muốn chạy local bằng file Excel Danh_Sach_Nhan_Dinh_Ho_Bach.xlsx
GOOGLE_SHEET_ID=

# Đường dẫn file service_account.json (hoặc dán nguyên nội dung JSON khi deploy lên Render)
GOOGLE_SERVICE_ACCOUNT_JSON=
